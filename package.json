{
  "name": "dice-architect",
  "private": true,
  "version": "1.0.0",
  "description": "주사위 던전 건축가 (Dice Architect) - iOS Portrait Roguelike Dungeon Tile Builder",
  "author": "Byeong Gyun Oh",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ios:assets": "node scripts/generate-ios-assets.mjs",
    "ios:init": "npm run build && npx cap add ios && npx cap sync ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
